<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TPLink.Gateway</RootNamespace>
    <AssemblyName>FrApp42.TPLink.Gateway</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <Company>FrApp42</Company>
    <Description>REST API gateway for the TP-Link Archer MR600 router, reproducing the plewin/tp-link-modem-router bridge API on top of the FrApp42.TP-Link library.</Description>
    <Copyright>GPL-3.0</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TP-Link\TP-Link.csproj" />
  </ItemGroup>

</Project>
